# Foodies Environment Configuration Template
# In production, copy to /etc/foodies/foodies.env (root:foodies, mode 640)
# DO NOT commit real secrets or production credentials to git.

# Application Environment: 'production' or 'development'
APP_ENV=production

# Application Secret Key: Must be at least 32 characters in production.
# Refuses to start if missing, <32 chars, or matching known placeholders.
# Generate with: openssl rand -hex 32
SECRET_KEY=generate_a_random_32_plus_char_secret_key_here

# Storage Mode: 's3' (for AWS S3 private storage) or 'local'
STORAGE_MODE=s3

# Amazon S3 Bucket Name: Required when STORAGE_MODE=s3
# In production, must be explicitly set to your actual S3 bucket name
S3_BUCKET=foodies-uploads-2026

# AWS Region where your S3 bucket and EC2 instance reside
AWS_REGION=us-east-1

# SQLite Database Path: Absolute path outside web document root
DATABASE_PATH=/var/lib/foodies/foodies.db

# Cookie Security: Set to 'true' in production (default) so cookies require HTTPS
COOKIE_SECURE=true

# Allowed Hosts: Hostnames permitted by reverse proxy and application
ALLOWED_HOSTS=foodies.duckdns.org,localhost,127.0.0.1
