[Unit]
Description=Foodies Cloud Python WSGI Application
After=network.target

[Service]
Type=simple
User=foodies
Group=foodies
WorkingDirectory=/opt/foodies

# Securely load production secrets and configuration
EnvironmentFile=/etc/foodies/foodies.env
Environment="PATH=/opt/foodies/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="PORT=8080"
Environment="HOST=127.0.0.1"

# Ensure runtime directories exist and apply schema migrations idempotently
ExecStartPre=/bin/mkdir -p /var/log/foodies /var/lib/foodies
ExecStartPre=/opt/foodies/venv/bin/python manage.py migrate

ExecStart=/opt/foodies/venv/bin/gunicorn \
    --workers 3 \
    --threads 2 \
    --bind 127.0.0.1:8080 \
    --timeout 120 \
    --access-logfile /var/log/foodies/access.log \
    --error-logfile /var/log/foodies/error.log \
    app:app

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=10
PrivateTmp=true
Restart=always
RestartSec=5

# Restrict filesystem access and grant write access only to data and log folders
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/foodies /var/log/foodies -/tmp

[Install]
WantedBy=multi-user.target
